# Copy to .env and fill in. Never commit .env.

# Only used by scripts/start-funnel.sh (which port to expose via Tailscale
# Funnel) — the web server itself always listens on 3000.
PORT=3000

# SQLite cache database (rebuildable — see prisma/schema.prisma). Prisma
# resolves this relative to prisma/schema.prisma, not the repo root, so this
# actually lands at prisma/data/photomap.db.
DATABASE_URL="file:./data/photomap.db"

# Folder of trip photos, one subfolder per trip. Folder name = slug = NFC URL path.
ASSETS_DIR=./assets

# Resized/EXIF-stripped photo cache served to visitors.
CACHE_DIR=./data/cache

# km or mi.
UNITS=km

# Set to "off" to skip fetching weather during `--photos-template` (weather
# is otherwise cached into trip.json there, never fetched during a normal
# ingest).
INGEST_WEATHER=

# Optional: a free Mapbox account's URL-restricted PUBLIC token, for the
# satellite map + globe, and for the trip page's streets map style. Leave
# blank to fall back to keyless Esri tiles via MapLibre (lower detail, no
# globe projection).
NEXT_PUBLIC_MAPBOX_TOKEN=
