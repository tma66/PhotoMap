# Copy to .env and fill in. Never commit .env.

# Where the app listens.
PORT=3000

# SQLite cache database (rebuildable — see prisma/schema.prisma).
DATABASE_URL="file:./data/travel-steps.db"

# Folder of trip photos, one subfolder per trip. Folder name = slug = NFC URL path.
ASSETS_DIR=./assets

# Resized/EXIF-stripped photo cache served to visitors.
CACHE_DIR=./data/cache

# km or mi.
UNITS=km

# Optional: a free Mapbox account's URL-restricted PUBLIC token, for the
# satellite map + globe. Leave blank to fall back to keyless Esri satellite
# tiles via MapLibre (lower detail, no globe projection).
NEXT_PUBLIC_MAPBOX_TOKEN=
