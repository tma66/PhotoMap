# Copy to .env and fill in. Never commit .env.

# SQLite cache database (rebuildable — see prisma/schema.prisma). Prisma
# resolves this relative to prisma/schema.prisma, not the repo root, so this
# actually lands at prisma/data/photomap.db.
DATABASE_URL="file:./data/photomap.db"

# Folder of trip photos, one subfolder per trip. Folder name = slug = NFC URL path.
ASSETS_DIR=./assets

# Resized/EXIF-stripped photo cache served to visitors.
CACHE_DIR=./data/cache

# km or mi.
UNITS=km

# Set to "off" to skip fetching weather during `--photos-template` and
# step-location changes (weather is otherwise cached into trip.json there,
# never fetched during a normal ingest).
INGEST_WEATHER=

# Where ingest reaches the running site to refresh its cached pages after
# changing trip data (defaults to http://localhost:3000).
SITE_URL=

# Optional: a free Mapbox account's URL-restricted PUBLIC token, for the
# satellite and streets map tiles and the place search when changing a
# step's location. Leave blank to fall back to keyless Esri tiles via
# MapLibre (lower detail, no place search).
NEXT_PUBLIC_MAPBOX_TOKEN=
